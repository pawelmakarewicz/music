# Number from your RP profile URL: radioparadise.com/account/profile/<id>
RP_USER_ID=
# Where `npm run download` saves the RP export (CSV includes ratings).
RP_FAVORITES_FILE=.data/rp_favorites.csv
# Only songs rated at least this high are synced.
RP_MIN_RATING=7

# TIDAL app from https://developer.tidal.com/ (see README). Register the
# redirect URI below exactly and allow playlists.read, playlists.write, search.read.
TIDAL_CLIENT_ID=
TIDAL_REDIRECT_URI=http://127.0.0.1:8787/callback
# Optional manual override. Normally `npm run tidal:login` manages local tokens.
TIDAL_ACCESS_TOKEN=
TIDAL_PLAYLIST_ID=
TIDAL_COUNTRY_CODE=PL
