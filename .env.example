# Local Radio Paradise export (Title - Artist, one entry per line).
RP_FAVORITES_FILE=rp_favorites.txt
RP_MIN_RATING=7

# TIDAL access token with at least playlists.write. Create an app/token at
# https://developer.tidal.com/ . Register the redirect URI below exactly.
TIDAL_CLIENT_ID=
TIDAL_REDIRECT_URI=http://127.0.0.1:8787/callback
# Optional manual override. Normally `npm run tidal:login` manages local tokens.
TIDAL_ACCESS_TOKEN=
TIDAL_PLAYLIST_ID=
TIDAL_COUNTRY_CODE=PL
